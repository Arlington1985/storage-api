# .env (Static config for LOCAL and DEV deployment)
# NO SECRETS HERE! (INTERNAL_API_KEY / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
# come from .envrc / Secret Manager)

APP_ENV=development
LOCAL_DEV_PORT=5060

# Cloudflare R2 (product photo storage). R2_ENDPOINT_URL is the bucket-LESS
# account endpoint - do NOT append the bucket name here, it goes in R2_BUCKET.
R2_ENDPOINT_URL=https://e8d3328b06654abaa75b969784762d90.r2.cloudflarestorage.com
R2_BUCKET=ramsofter
# Public read base (R2's public dev URL for now). This service redirects
# GET /<provider_id>/<filename> requests here.
R2_PUBLIC_BASE_URL=https://pub-106b81a8eea342578bf68aa811a8c0ba.r2.dev
