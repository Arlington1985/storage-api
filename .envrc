#!/usr/bin/env bash
# .envrc - Fetches DEV secrets into the shell environment via gcloud.
# SAFE TO COMMIT - Contains no secret values itself.

fetch_secret() {
  local secret_id=$1
  local gcp_project_id=${GCP_PROJECT_ID:-$(gcloud config get-value project 2>/dev/null)}

  if [ -z "$gcp_project_id" ]; then
    echo "Warning: GCP_PROJECT_ID not set and gcloud project not configured. Cannot fetch secret: $secret_id" >&2
    return 1
  fi

  if ! gcloud secrets versions access latest --secret="$secret_id" --project="$gcp_project_id" --quiet > /dev/null 2>&1; then
     echo "Warning: Failed to access secret '$secret_id'. Check 'gcloud auth login', 'gcloud auth application-default login', and permissions." >&2
     return 1
  fi

  gcloud secrets versions access latest --secret="$secret_id" --project="$gcp_project_id" --quiet
}

echo "Loading DEVELOPMENT secrets into shell from Google Secret Manager..."

: ${INTERNAL_API_KEY=$(fetch_secret "storage-internal-api-key-dev")}
: ${R2_ACCESS_KEY_ID=$(fetch_secret "r2-access-key-id-dev")}
: ${R2_SECRET_ACCESS_KEY=$(fetch_secret "r2-secret-access-key-dev")}

export INTERNAL_API_KEY R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
